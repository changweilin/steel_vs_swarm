{
  "name": "steel-vs-swarm",
  "version": "0.1.0",
  "description": "無人戰略:鋼鐵與蜂群 — 真實世界地圖上的無人機 vs 機器人 DOTA+FPS 對戰",
  "type": "module",
  "main": "server/server.js",
  "license": "Apache-2.0",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js --port 8620",
    "lan": "node server/server.js --lan --https",
    "cloud": "node server/server.js --cloud",
    "mobile": "node server/server.js --https",
    "build:solo": "node tools/build_solo.mjs",
    "test": "node test/e2e.mjs",
    "check": "node tools/audit_suite.mjs",
    "map:evidence": "node tools/prepare_map_evidence.mjs",
    "audit:map-evidence": "node tools/audit_map_evidence.mjs",
    "audit:habitat": "node tools/audit_habitat.mjs",
    "audit:facilities": "node tools/audit_facility_fusion.mjs",
    "shot:habitat": "node tools/shot_habitat.mjs",
    "shot:map-evidence": "node tools/shot_map_evidence.mjs --creation",
    "audit:core": "node tools/audit_suite.mjs",
    "audit:offline": "node tools/audit_offline_suite.mjs",
    "audit:all": "node tools/audit_suite.mjs && node tools/audit_offline_suite.mjs",
    "audit:visual": "node tools/audit_visual_presets.mjs && node tools/audit_visual_prefs.mjs && node tools/audit_cel_pipeline.mjs",
    "sim": "node test/simrun.mjs",
    "bal": "node tools/balance.mjs",
    "bal:ci": "node tools/balance.mjs --ci",
    "bal:strict": "node tools/balance.mjs --strict",
    "audit:net": "node tools/audit_net_modes.mjs",
    "audit:aoe": "node tools/audit_aoe_balance.mjs",
    "osm:catalog": "node tools/osm_catalog.mjs",
    "osm:fixture": "node tools/fetch_osm_fixture.mjs",
    "audit:osm-catalog": "node tools/audit_osm_catalog.mjs",
    "audit:osm-fixtures": "node tools/audit_osm_fixtures.mjs",
    "shot:background": "node tools/shot_background_objects.mjs",
    "author:transport-source": "node tools/transport_authoring/source.mjs",
    "shot:transport": "node tools/transport_authoring/shot.mjs",
    "audit:transport": "node test/transportAppearance.mjs",
    "shot:scenery": "node tools/scenery_authoring/shot.mjs",
    "audit:scenery": "node test/sceneryAppearance.mjs",
    "audit:scene-models": "node tools/audit_scene_models.mjs",
    "audit:scene-damage": "node tools/audit_scene_damage.mjs",
    "audit:building-damage": "node tools/audit_building_damage.mjs",
    "audit:building-motion": "node tools/audit_building_motion.mjs",
    "audit:unit-damage": "node tools/audit_unit_damage.mjs",
    "audit:unit-motion": "node tools/audit_unit_motion.mjs",
    "audit:biped-posture": "node tools/audit_biped_posture.mjs",
    "audit:faction-models": "node tools/audit_faction_models.mjs",
    "audit:civilians": "node tools/audit_civilian_generator.mjs",
    "audit:vfx": "node tools/audit_combat_vfx.mjs",
    "audit:weather": "node tools/audit_weather_surface.mjs",
    "audit:waves": "node tools/audit_water_edge.mjs && node tools/audit_wavefronts.mjs",
    "shot:weather": "node tools/shot_weather_surface.mjs",
    "shot:weather-fx": "node tools/shot_weather_fx.mjs",
    "shot:building-damage": "node tools/shot_building_damage.mjs",
    "story": "node tools/story_book.mjs",
    "preview:gen": "node tools/arch_preview.mjs",
    "shot:geographic": "node tools/shot_geographic_preview.mjs",
    "review:mechs": "node tools/mech_prompt_review.mjs",
    "author:mechs": "node tools/mech_authoring/build.mjs",
    "audit:reference-mechs": "node tools/audit_reference_mechs.mjs",
    "author:morphers": "node tools/mech_authoring/build.mjs --contract morphers.json",
    "audit:reference-morph": "node tools/audit_reference_morph.mjs"
  },

  "dependencies": {
    "ws": "^8.18.0"
  }
}
